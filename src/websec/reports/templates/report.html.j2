<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reporte de Auditoría de Seguridad - {{ result.target.domain }}</title>
  <style>
    :root {
      --bg-primary: #0f172a;
      --bg-secondary: #1e293b;
      --bg-card: #334155;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #475569;
      --color-critical: #ef4444;
      --color-high: #f97316;
      --color-medium: #eab308;
      --color-low: #3b82f6;
      --color-info: #06b6d4;
      --color-success: #10b981;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-main);
      padding: 2rem 1rem;
      line-height: 1.6;
    }
    .container { max-width: 1100px; margin: 0 auto; }
    header {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .header-title h1 { font-size: 1.8rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem; }
    .header-title p { color: var(--text-muted); font-size: 0.95rem; }
    .grade-badge {
      text-align: center;
      padding: 1.2rem 2rem;
      background: var(--bg-secondary);
      border: 2px solid var(--border-color);
      border-radius: 12px;
      min-width: 140px;
    }
    .grade-letter { font-size: 3rem; font-weight: 900; line-height: 1; margin-bottom: 0.3rem; }
    .grade-score { font-size: 1rem; color: var(--text-muted); font-weight: 600; }
    .grade-A, .grade-A\+ { color: var(--color-success); border-color: var(--color-success); }
    .grade-B { color: var(--color-info); border-color: var(--color-info); }
    .grade-C { color: var(--color-medium); border-color: var(--color-medium); }
    .grade-D { color: var(--color-high); border-color: var(--color-high); }
    .grade-F { color: var(--color-critical); border-color: var(--color-critical); }
    
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .stat-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1.2rem;
      text-align: center;
    }
    .stat-val { font-size: 1.8rem; font-weight: 700; }
    .stat-label { color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }

    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .filter-buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .filter-btn {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.5rem 1rem;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.2s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: #3b82f6;
      border-color: #3b82f6;
      color: white;
    }
    .btn-print {
      background: #10b981;
      border: none;
      color: white;
      padding: 0.6rem 1.2rem;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.2s;
    }
    .btn-print:hover { background: #059669; }

    .finding-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-left: 6px solid var(--border-color);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 1.2rem;
      transition: transform 0.15s ease;
    }
    .finding-card:hover { transform: translateY(-2px); }
    .severity-Crítica { border-left-color: var(--color-critical); }
    .severity-Alta { border-left-color: var(--color-high); }
    .severity-Media { border-left-color: var(--color-medium); }
    .severity-Baja { border-left-color: var(--color-low); }
    .severity-Informativa { border-left-color: var(--color-info); }

    .finding-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.8rem;
      gap: 1rem;
    }
    .finding-title { font-size: 1.2rem; font-weight: 700; color: #fff; }
    .sev-pill {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      text-transform: uppercase;
    }
    .pill-Crítica { background: rgba(239, 68, 68, 0.2); color: var(--color-critical); border: 1px solid var(--color-critical); }
    .pill-Alta { background: rgba(249, 115, 22, 0.2); color: var(--color-high); border: 1px solid var(--color-high); }
    .pill-Media { background: rgba(234, 179, 8, 0.2); color: var(--color-medium); border: 1px solid var(--color-medium); }
    .pill-Baja { background: rgba(59, 130, 246, 0.2); color: var(--color-low); border: 1px solid var(--color-low); }
    .pill-Informativa { background: rgba(6, 182, 212, 0.2); color: var(--color-info); border: 1px solid var(--color-info); }

    .finding-desc { margin-bottom: 1rem; color: #cbd5e1; font-size: 0.95rem; }
    .finding-section { margin-bottom: 0.6rem; font-size: 0.9rem; }
    .finding-section strong { color: #f1f5f9; }
    .code-box {
      background: #090d16;
      border: 1px solid #1e293b;
      padding: 0.6rem 0.8rem;
      border-radius: 4px;
      font-family: monospace;
      font-size: 0.85rem;
      color: #38bdf8;
      overflow-x: auto;
      margin-top: 0.4rem;
    }
    footer {
      text-align: center;
      margin-top: 3rem;
      color: var(--text-muted);
      font-size: 0.85rem;
      border-top: 1px solid var(--border-color);
      padding-top: 1.5rem;
    }
    @media print {
      body { background: white; color: black; padding: 0; }
      header, .stat-card, .finding-card { background: white !important; border: 1px solid #ccc !important; color: black !important; }
      .finding-title, .finding-desc, .finding-section strong { color: black !important; }
      .controls-bar { display: none !important; }
      .code-box { background: #f1f5f9 !important; color: #0f172a !important; border-color: #cbd5e1 !important; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-title">
        <h1>WebSec Auditor - Reporte de Seguridad</h1>
        <p><strong>Objetivo auditado:</strong> {{ result.target.url }} ({{ result.target.domain }})</p>
        <p><strong>Fecha y hora:</strong> {{ result.stats.start_time.strftime('%Y-%m-%d %H:%M:%S UTC') }}</p>
        <p><strong>Duración:</strong> {{ "%.2f"|format(result.stats.duration_seconds) }} s &bull; <strong>Páginas analizadas:</strong> {{ result.stats.pages_crawled }}</p>
      </div>
      <div class="grade-badge grade-{{ result.score.grade }}">
        <div class="grade-letter">{{ result.score.grade }}</div>
        <div class="grade-score">{{ result.score.score }}/100</div>
      </div>
    </header>

    <div class="stats-grid">
      <div class="stat-card" style="border-top: 3px solid var(--color-critical);">
        <div class="stat-val" style="color: var(--color-critical);">{{ result.score.breakdown['Crítica'] }}</div>
        <div class="stat-label">Críticas</div>
      </div>
      <div class="stat-card" style="border-top: 3px solid var(--color-high);">
        <div class="stat-val" style="color: var(--color-high);">{{ result.score.breakdown['Alta'] }}</div>
        <div class="stat-label">Altas</div>
      </div>
      <div class="stat-card" style="border-top: 3px solid var(--color-medium);">
        <div class="stat-val" style="color: var(--color-medium);">{{ result.score.breakdown['Media'] }}</div>
        <div class="stat-label">Medias</div>
      </div>
      <div class="stat-card" style="border-top: 3px solid var(--color-low);">
        <div class="stat-val" style="color: var(--color-low);">{{ result.score.breakdown['Baja'] }}</div>
        <div class="stat-label">Bajas</div>
      </div>
      <div class="stat-card" style="border-top: 3px solid var(--color-info);">
        <div class="stat-val" style="color: var(--color-info);">{{ result.score.breakdown['Informativa'] }}</div>
        <div class="stat-label">Informativas</div>
      </div>
    </div>

    <div class="controls-bar">
      <div class="filter-buttons">
        <button class="filter-btn active" onclick="filterFindings('all')">Todos ({{ result.findings|length }})</button>
        <button class="filter-btn" onclick="filterFindings('Crítica')">Críticas</button>
        <button class="filter-btn" onclick="filterFindings('Alta')">Altas</button>
        <button class="filter-btn" onclick="filterFindings('Media')">Medias</button>
        <button class="filter-btn" onclick="filterFindings('Baja')">Bajas</button>
        <button class="filter-btn" onclick="filterFindings('Informativa')">Informativas</button>
      </div>
      <button class="btn-print" onclick="window.print()">🖨️ Imprimir / Guardar PDF</button>
    </div>

    <section id="findings-container">
      {% for f in result.findings %}
      <div class="finding-card severity-{{ f.severity.value }}" data-severity="{{ f.severity.value }}">
        <div class="finding-header">
          <div class="finding-title">[{{ f.id }}] {{ f.title }}</div>
          <span class="sev-pill pill-{{ f.severity.value }}">{{ f.severity.value }}</span>
        </div>
        <div class="finding-desc">{{ f.description }}</div>
        {% if f.evidence %}
        <div class="finding-section">
          <strong>Evidencia de detección:</strong>
          <div class="code-box">{{ f.evidence }}</div>
        </div>
        {% endif %}
        <div class="finding-section"><strong>Impacto:</strong> {{ f.impact }}</div>
        <div class="finding-section"><strong>Recomendación paso a paso:</strong> {{ f.recommendation }}</div>
        <div class="finding-section"><strong>Referencia técnica:</strong> <a href="{{ f.reference }}" target="_blank" style="color: #38bdf8;">{{ f.reference }}</a></div>
      </div>
      {% endfor %}
      {% if not result.findings %}
      <div style="text-align: center; padding: 3rem; background: var(--bg-secondary); border-radius: 8px;">
        <h3 style="color: var(--color-success); margin-bottom: 0.5rem;">🎉 No se encontraron vulnerabilidades</h3>
        <p style="color: var(--text-muted);">El objetivo superó satisfactoriamente todas las pruebas de seguridad ejecutadas.</p>
      </div>
      {% endif %}
    </section>

    <footer>
      Generado éticamente por <strong>WebSec Auditor v1.0</strong> &bull; Herramienta de auditoría autorizada no destructiva.
    </footer>
  </div>

  <script>
    function filterFindings(severity) {
      const cards = document.querySelectorAll('.finding-card');
      const buttons = document.querySelectorAll('.filter-btn');
      
      buttons.forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      cards.forEach(card => {
        if (severity === 'all' || card.getAttribute('data-severity') === severity) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }
  </script>
</body>
</html>
